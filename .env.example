NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key

# Måste vara en avsändare vars domän är VERIFIERAD i Resend, annars nekas
# varje utskick med 403. Saknas värdet loggar src/lib/email.ts ett tydligt
# fel vid uppstart i stället för att misslyckas tyst.
RESEND_FROM_EMAIL=noreply@prolink.se

# Publik adress till sajten. Används för metadata, delningslänkar och länkar
# i utgående mejl, så den ska peka på den domän besökaren faktiskt använder.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects GET /api/cron/notifications; set a random secret in the deployment.
CRON_SECRET=

# En kontaktadress som faktiskt tar emot support och kontofrågor.
NEXT_PUBLIC_CONTACT_EMAIL=

# Adminsidan /admin. Kommaseparerade e-postadresser som får öppna den; kontot
# måste ha bekräftad e-post. Alla andra får 404.
ADMIN_EMAILS=
# Dina egna test- och demokonton. De räknas bort ur statistiken, så att
# siffrorna visar vad riktiga användare gör, men får ingen adminåtkomst.
INTERNAL_EMAILS=

# Maskinöversättning av uppdrag och tjänster för besökare på engelska
# (src/lib/content-translation.ts). Saknas nyckeln visas annonserna på
# svenska; allt annat på engelska fungerar ändå. Översättningarna sparas i
# tabellen content_translations (migration 028), så varje annons översätts
# bara en gång tills texten ändras.
ANTHROPIC_API_KEY=
# Valfritt: modell för översättningen. Standard är claude-haiku-5-5.
ANTHROPIC_TRANSLATION_MODEL=

# Premium för frilansare (Stripe). Utan STRIPE_SECRET_KEY och
# STRIPE_PREMIUM_PRICE_ID döljs all Premium-text och sajten fungerar som förut.
# Skapa en produkt med ett återkommande månadspris i Stripe och lägg priset
# (price_...) här. Webhooken pekar på /api/stripe/webhook och ska lyssna på
# customer.subscription.created, .updated och .deleted. Aktivera kundportalen
# under Settings > Billing > Customer portal.
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Google Ads (valfritt). Utan tagg-ID visas ingen cookie-ruta och ingen
# Google-tagg laddas. Taggen laddas först när besökaren godkänt annonscookies.
# Etiketterna är delen efter snedstrecket i send_to: 'AW-.../etikett' för
# respektive konverteringsåtgärd; utan etikett mäts den konverteringen inte.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_SIGNUP=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_JOB=
